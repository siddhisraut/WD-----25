<!DOCTYPE html>
<html>
<head>
<title>Registration Page</title>
<style>
body{
font-family: Arial;
background-color: lightgray;
}
h2{
text-align: center;
}
form{
width:400px;
background:white;
padding:20px;
margin:auto;
border-radius:8px;
box-shadow:0 0 10px gray;
}
input,select{
width:100%;
padding:8px;
margin-top:5px;
}
button{
background-color:green;
color:white;
padding:10px;
width:100%;
border:none;
font-size:16px;
}
button:hover{
background-color:darkgreen;
}
</style>
</head>
<body>
<h2>Student Registration Form</h2>
<form>
<label>First Name:</label>
<input type="text" name="fname"><br><br>
<label>Middle Name:</label>
<input type="text" name="mname"><br><br>
<label>Last Name:</label>
<input type="text" name="lname"><br><br>
<label>Date of Birth:</label>
<input type="text" name="dob" placeholder="DD/MM/YYYY"><br><br>
<label>Gender:</label><br>
<input type="radio" name="gender"> Male
<input type="radio" name="gender"> Female
<br><br>
<label>Address:</label>
<input type="text" name="address"><br><br>
<label>College Name:</label>
<select name="college">
<option>KIT'S College of Engineering Kolhapur</option>
<option>D.Y. Patil College of Engineering Kolhapur</option>
<option>Bharati Vidyapeeth Kolhapur</option>
</select>
<br><br>
<label>Branch:</label>
<select name="branch">
<option>AIML</option>
<option>Computer Science</option>
<option>Information Technology</option>
<option>Electronics</option>
</select>
<br><br>
<label>Tech Skills:</label><br>
<input type="checkbox"> HTML
<input type="checkbox"> CSS
<input type="checkbox"> Java
<input type="checkbox"> Python
<br><br>
<button onclick="alert('Registration is Successfully Completed!')">
Submit
</button>
</form>
</body>
</html>
